{
  "name": "axon-tickets",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "delete-ian": "npm run delete-ian --workspace=apps/api"
  },
  "dependencies": {
    "@nestjs/common": "11.1.28",
    "@nestjs/core": "11.1.28",
    "@sentry/bundler-plugin-core": "5.3.0",
    "ajv": "8.20.0",
    "brace-expansion": "5.0.9",
    "next": "15.5.22",
    "postcss": "8.5.23",
    "rxjs": "7.8.1",
    "sharp": "0.35.3",
    "webpack": "5.109.0"
  },
  "devDependencies": {
    "prettier": "^3.3.0",
    "prisma": "^5.22.0",
    "turbo": "^2.0.0",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "overrides": {
    "@nestjs/common": "11.1.28",
    "@nestjs/core": "11.1.28",
    "ajv@>=7": "8.20.0",
    "brace-expansion@>=5": "5.0.9",
    "postcss": "8.5.23",
    "sharp": "0.35.3",
    "webpack": "5.109.0",
    "next@15.5.22": {
      "postcss": "$postcss",
      "sharp": "$sharp"
    },
    "@sentry/bundler-plugin-core": {
      "brace-expansion": "$brace-expansion"
    },
    "@nestjs/swagger@11.4.6": {
      "js-yaml": "5.2.3"
    }
  },
  "packageManager": "npm@11.0.0"
}

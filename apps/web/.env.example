# For local development
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
# For production, use: https://api.axontickets.online/api/v1

# Deployment target. Controls UAT banner, analytics, and Sentry environment tag.
# Valid values: development | uat | production
# UAT Vercel env: NEXT_PUBLIC_APP_ENV=uat
# Production Vercel env: NEXT_PUBLIC_APP_ENV=production
NEXT_PUBLIC_APP_ENV=development

NEXT_PUBLIC_HCAPTCHA_SITE_KEY=your-hcaptcha-site-key

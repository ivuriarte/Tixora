# -----------------------------------------------
# AXON TICKETS API — Environment Variables
# Copy this to .env and fill in real values.
# NEVER commit .env to git.
# -----------------------------------------------

# --- App ---
NODE_ENV=development
# APP_ENV distinguishes deployment target independently of NODE_ENV.
# UAT runs NODE_ENV=production (optimised build) but APP_ENV=uat.
# Valid values: development | uat | production
APP_ENV=development
PORT=3001
API_URL=http://localhost:3001
WEB_URL=http://localhost:3000
# For production, use: https://axontickets.online,https://www.axontickets.online
ALLOWED_ORIGINS=http://localhost:3000

# --- Database (Supabase PostgreSQL) ---
# Production / local dev — copy these from Supabase → Connect → ORM → Prisma
# DATABASE_URL: transaction pooler (port 6543, used at runtime by the API)
# DIRECT_URL:   direct connection (port 5432, used only by prisma migrate)
DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
DIRECT_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres

# --- UAT Database (Supabase UAT project) ---
# Used by: npm run db:migrate:uat  and  npm run db:reset:uat
# Copy from your separate UAT Supabase project → Connect → ORM → Prisma
# Leave blank if UAT project not yet created.
DATABASE_URL_UAT=
DIRECT_URL_UAT=

# --- Redis (Upstash) ---
REDIS_URL=rediss://default:PASSWORD@xxxx.upstash.io:6379

# --- JWT (RS256) ---
# Generate: openssl genrsa -out private.pem 2048
#           openssl rsa -in private.pem -pubout -out public.pem
# Paste the full PEM content (with newlines replaced by \n) here.
JWT_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# --- QR Tickets ---
# Generate: openssl rand -hex 32
QR_HMAC_SECRET=your-32-byte-hex-secret-here

# --- SMTP (email) ---
# The API uses Nodemailer over SMTP. Any SMTP provider works.
#
# Recommended: Brevo (brevo.com) — free tier sends 300 emails/day
#   Host: smtp-relay.brevo.com  Port: 587  User: your-brevo-login-email  Pass: your-brevo-SMTP-key
#
# Alternative: Gmail app password, SendGrid, Mailjet, etc.
#
# ⚠️  IMPORTANT — ALL four vars below are REQUIRED.
#     The app will not start if any are missing or empty.
#     After updating these in Vercel, redeploy the API.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your-brevo-login@example.com
SMTP_PASS=your-brevo-smtp-key
SMTP_FROM_EMAIL=noreply@yourdomain.com
SMTP_FROM_NAME=Axon Tickets

# --- Cloudinary ---
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# --- PayMongo ---
PAYMONGO_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxxxxxx
PAYMONGO_PUBLIC_KEY=pk_live_xxxxxxxxxxxxxxxxxxxx
PAYMONGO_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxx

# --- hCaptcha ---
HCAPTCHA_SECRET=your-hcaptcha-secret-key

# --- Rate limiting ---
THROTTLE_TTL=60000
THROTTLE_LIMIT=60

# -----------------------------------------------
# FEATURE FLAGS
# Set PAYMONGO_ENABLED=false to use manual-payment-only mode
# -----------------------------------------------
PAYMONGO_ENABLED=true
HCAPTCHA_SECRET=0x...

# --- Sentry ---
SENTRY_DSN=https://xxxx@oxxxx.ingest.sentry.io/xxxx

# --- Rate Limiting ---
THROTTLE_TTL=60000
THROTTLE_LIMIT=60

# --- Seed (UAT only) ---
# Required when running: npm run db:seed  or  npm run db:reset:uat
# SEED_ADMIN_EMAIL:    the admin account email that will be created/updated
# SEED_ADMIN_PASSWORD: optional — if unset, a random password is generated and printed
SEED_ADMIN_EMAIL=your-email@example.com
SEED_ADMIN_PASSWORD=

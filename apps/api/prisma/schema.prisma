// Prisma schema for Axon Tickets Online Ticketing Platform
// Run: npx prisma migrate dev --name init

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum EventStatus {
  draft
  on_sale
  sold_out
  cancelled
  completed
}

enum OrderStatus {
  pending
  paid
  cancelled
  refunded
  failed
}

enum TicketStatus {
  valid
  used
  cancelled
  refunded
}

enum ReservationStatus {
  active
  expired
  converted
  released
}

enum OtpType {
  email_verify
  login
  phone_verify
}

enum RegistrationStatus {
  pending_payment
  proof_submitted
  verified
  rejected
  cancelled
}

enum ProofStatus {
  pending
  approved
  rejected
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  phone        String?
  firstName    String?  @map("first_name")
  lastName     String?  @map("last_name")
  passwordHash String?  @map("password_hash")
  googleId     String?  @unique @map("google_id")
  avatarUrl    String?  @map("avatar_url")
  isVerified   Boolean  @default(false) @map("is_verified")
  isAdmin      Boolean  @default(false) @map("is_admin")
  fraudScore   Int      @default(0) @map("fraud_score")
  // Conference registration fields (added for Francis Kong MVP)
  company      String?  @map("company")
  jobTitle     String?  @map("job_title")
  city         String?  @map("city")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  reservations          Reservation[]
  orders                Order[]
  tickets               Ticket[]
  otpCodes              OtpCode[]
  fraudFlags            FraudFlag[]
  events                Event[]         @relation("CreatedBy")
  checkIns              Ticket[]        @relation("CheckedInBy")
  confirmedOrders       Order[]         @relation("ConfirmedByAdmin")
  registrations         Registration[]
  verifiedRegistrations Registration[]  @relation("VerifiedBy")
  reviewedProofs        PaymentProof[]  @relation("ReviewedBy")
  auditLogs             AuditLog[]      @relation("AuditPerformedBy")

  @@map("users")
}

model Event {
  id           String      @id @default(uuid())
  slug         String      @unique
  title        String
  description  String?
  venue        String
  address      String?     @map("address")
  landmark     String?     @map("landmark")
  city         String      @default("Manila")
  latitude     Decimal?    @db.Decimal(10, 7)
  longitude    Decimal?    @db.Decimal(10, 7)
  startsAt     DateTime    @map("starts_at")
  endsAt       DateTime?   @map("ends_at")
  imageUrl     String?     @map("image_url")
  status       EventStatus @default(draft)
  maxCapacity  Int?        @map("max_capacity")
  maxPerUser   Int         @default(4) @map("max_per_user")
  // Conference-specific fields (added for Francis Kong MVP)
  speakerName  String?     @map("speaker_name")
  agenda       Json?       // Array of { time: string, title: string, description?: string }
  sponsors     Json?       // Array of { name: string, logoUrl?: string, tier?: string }
  faqs         Json?       // Array of { question: string, answer: string }
  platformFee         Decimal     @default(50) @db.Decimal(10, 2) @map("platform_fee")
  // Payment configuration
  paymentMethods      Json?       @map("payment_methods")  // Array of PaymentMethod objects
  allowManualPayment  Boolean     @default(true) @map("allow_manual_payment")
  bankName            String?     @map("bank_name")
  bankAccountNumber   String?     @map("bank_account_number")
  bankAccountName     String?     @map("bank_account_name")
  gcashNumber         String?     @map("gcash_number")
  createdById         String      @map("created_by_id")
  createdAt           DateTime    @default(now()) @map("created_at")
  updatedAt           DateTime    @updatedAt @map("updated_at")

  createdBy     User           @relation("CreatedBy", fields: [createdById], references: [id])
  tiers         TicketTier[]
  reservations  Reservation[]
  orders        Order[]
  tickets       Ticket[]
  registrations Registration[]
  eventViews    EventView[]

  @@index([status, startsAt])
  @@index([slug])
  @@map("events")
}

model TicketTier {
  id           String    @id @default(uuid())
  eventId      String    @map("event_id")
  name         String
  description  String?
  price        Decimal   @db.Decimal(10, 2)
  currency     String    @default("PHP")
  totalQuantity Int      @map("total_quantity")
  soldQuantity  Int      @default(0) @map("sold_quantity")
  maxPerOrder  Int       @default(4) @map("max_per_order")
  saleStartsAt DateTime? @map("sale_starts_at")
  saleEndsAt   DateTime? @map("sale_ends_at")
  isVisible    Boolean   @default(true) @map("is_visible")
  sortOrder    Int       @default(0) @map("sort_order")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  event        Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  reservations Reservation[]
  orderItems   OrderItem[]
  tickets      Ticket[]
  registrations Registration[]

  @@index([eventId])
  @@map("ticket_tiers")
}

model Reservation {
  id              String            @id @default(uuid())
  userId          String            @map("user_id")
  ticketTierId    String            @map("ticket_tier_id")
  eventId         String            @map("event_id")
  quantity        Int
  expiresAt       DateTime          @map("expires_at")
  status          ReservationStatus @default(active)
  idempotencyKey  String            @unique @map("idempotency_key")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  user       User       @relation(fields: [userId], references: [id])
  ticketTier TicketTier @relation(fields: [ticketTierId], references: [id])
  event      Event      @relation(fields: [eventId], references: [id])
  order      Order?

  @@index([userId, status])
  @@index([status, expiresAt])
  @@map("reservations")
}

model Order {
  id              String      @id @default(uuid())
  userId          String      @map("user_id")
  reservationId   String      @unique @map("reservation_id")
  eventId         String      @map("event_id")
  status          OrderStatus @default(pending)
  subtotal        Decimal     @db.Decimal(10, 2)
  fees            Decimal     @db.Decimal(10, 2)
  total           Decimal     @db.Decimal(10, 2)
  currency        String      @default("PHP")
  paymentMethod   String?     @map("payment_method")
  paymentRef      String?     @map("payment_ref")
  paymentLinkId       String?     @map("payment_link_id")
  idempotencyKey      String      @unique @map("idempotency_key")
  ipAddress           String?     @map("ip_address")
  userAgent           String?     @map("user_agent")
  // Manual payment confirmation audit trail
  confirmedByAdminId  String?     @map("confirmed_by_admin_id")
  confirmedAt         DateTime?   @map("confirmed_at")
  createdAt           DateTime    @default(now()) @map("created_at")
  updatedAt           DateTime    @updatedAt @map("updated_at")

  user             User        @relation(fields: [userId], references: [id])
  reservation      Reservation @relation(fields: [reservationId], references: [id])
  event            Event       @relation(fields: [eventId], references: [id])
  items            OrderItem[]
  tickets          Ticket[]
  fraudFlags       FraudFlag[]
  confirmedByAdmin User?       @relation("ConfirmedByAdmin", fields: [confirmedByAdminId], references: [id])

  @@index([userId, status])
  @@index([eventId])
  @@index([status])
  @@map("orders")
}

model OrderItem {
  id           String   @id @default(uuid())
  orderId      String   @map("order_id")
  ticketTierId String   @map("ticket_tier_id")
  quantity     Int
  unitPrice    Decimal  @map("unit_price") @db.Decimal(10, 2)
  subtotal     Decimal  @db.Decimal(10, 2)
  createdAt    DateTime @default(now()) @map("created_at")

  order      Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  ticketTier TicketTier @relation(fields: [ticketTierId], references: [id])
  tickets    Ticket[]

  @@index([orderId])
  @@map("order_items")
}

model Ticket {
  id           String       @id @default(uuid())
  orderId      String       @map("order_id")
  orderItemId  String       @map("order_item_id")
  userId       String       @map("user_id")
  eventId      String       @map("event_id")
  ticketTierId String       @map("ticket_tier_id")
  qrCode       String       @unique @map("qr_code")
  status       TicketStatus @default(valid)
  checkedInAt  DateTime?    @map("checked_in_at")
  checkedInById String?     @map("checked_in_by_id")
  createdAt    DateTime     @default(now()) @map("created_at")

  order       Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderItem   OrderItem  @relation(fields: [orderItemId], references: [id])
  user        User       @relation(fields: [userId], references: [id])
  event       Event      @relation(fields: [eventId], references: [id])
  ticketTier  TicketTier @relation(fields: [ticketTierId], references: [id])
  checkedInBy User?      @relation("CheckedInBy", fields: [checkedInById], references: [id])

  @@index([userId])
  @@index([eventId, status])
  @@index([orderId])
  @@map("tickets")
}

model OtpCode {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  codeHash  String   @map("code_hash")
  type      OtpType
  expiresAt DateTime @map("expires_at")
  used      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type, used])
  @@index([expiresAt])
  @@map("otp_codes")
}

model FraudFlag {
  id        String   @id @default(uuid())
  userId    String?  @map("user_id")
  orderId   String?  @map("order_id")
  reason    String
  ipAddress String?  @map("ip_address")
  metadata  Json?
  resolvedAt DateTime? @map("resolved_at")
  createdAt DateTime @default(now()) @map("created_at")

  user  User?  @relation(fields: [userId], references: [id])
  order Order? @relation(fields: [orderId], references: [id])

  @@index([userId])
  @@index([orderId])
  @@map("fraud_flags")
}

// ── Manual-payment registration flow ─────────────────────────────────────────

model Registration {
  id              String             @id @default(uuid())
  referenceNumber String             @unique @map("reference_number")
  userId          String             @map("user_id")
  eventId         String             @map("event_id")
  tierId          String?            @map("tier_id")
  tierName        String?            @map("tier_name")
  unitPrice       Decimal?           @db.Decimal(10, 2) @map("unit_price")
  status          RegistrationStatus @default(pending_payment)
  attendeeCount   Int                @map("attendee_count")
  subtotal        Decimal            @db.Decimal(10, 2)
  fees            Decimal            @db.Decimal(10, 2)
  total           Decimal            @db.Decimal(10, 2)
  currency        String             @default("PHP")
  paymentMethod   String?            @map("payment_method")
  notes           String?
  rejectionReason String?            @map("rejection_reason")
  verifiedById    String?            @map("verified_by_id")
  verifiedAt      DateTime?          @map("verified_at")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  user       User           @relation(fields: [userId], references: [id])
  event      Event          @relation(fields: [eventId], references: [id])
  tier       TicketTier?    @relation(fields: [tierId], references: [id])
  attendees  Attendee[]
  proofs     PaymentProof[]
  verifiedBy User?          @relation("VerifiedBy", fields: [verifiedById], references: [id])
  auditLogs  AuditLog[]

  @@index([userId, status])
  @@index([eventId, status])
  @@index([referenceNumber])
  @@map("registrations")
}

model Attendee {
  id             String    @id @default(uuid())
  registrationId String    @map("registration_id")
  firstName      String    @map("first_name")
  lastName       String    @map("last_name")
  email          String
  phone          String?
  company        String?
  jobTitle       String?   @map("job_title")
  isLead         Boolean   @default(false) @map("is_lead")
  // Anti-scalper: tickets are bound to the attendee record above and cannot
  // be re-assigned. Reserved for a future admin-controlled transfer flow.
  transferable   Boolean   @default(false) @map("transferable")
  qrToken        String?   @unique @map("qr_token")
  checkedInAt    DateTime? @map("checked_in_at")
  checkedInById  String?   @map("checked_in_by_id")
  checkInMethod  String?   @map("check_in_method")
  createdAt      DateTime  @default(now()) @map("created_at")

  registration Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  @@index([registrationId])
  @@index([email])
  @@map("attendees")
}

model PaymentProof {
  id                 String      @id @default(uuid())
  registrationId     String      @map("registration_id")
  imageUrl           String      @map("image_url")
  cloudinaryPublicId String      @map("cloudinary_public_id")
  status             ProofStatus @default(pending)
  reviewedById       String?     @map("reviewed_by_id")
  reviewedAt         DateTime?   @map("reviewed_at")
  rejectionReason    String?     @map("rejection_reason")
  createdAt          DateTime    @default(now()) @map("created_at")

  registration Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  reviewedBy   User?         @relation("ReviewedBy", fields: [reviewedById], references: [id])

  @@index([registrationId])
  @@index([status])
  @@map("payment_proofs")
}

model AuditLog {
  id            String   @id @default(uuid())
  action        String
  entityType    String   @map("entity_type")
  entityId      String   @map("entity_id")
  registrationId String? @map("registration_id")
  performedById  String? @map("performed_by_id")
  metadata      Json?
  ipAddress     String?  @map("ip_address")
  createdAt     DateTime @default(now()) @map("created_at")

  registration Registration? @relation(fields: [registrationId], references: [id])
  performedBy  User?          @relation("AuditPerformedBy", fields: [performedById], references: [id])

  @@index([entityType, entityId])
  @@index([registrationId])
  @@index([performedById])
  @@index([createdAt])
  @@map("audit_logs")
}

model EventView {
  id        String   @id @default(uuid())
  eventId   String   @map("event_id")
  sessionId String?  @map("session_id")
  referrer  String?
  createdAt DateTime @default(now()) @map("created_at")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([createdAt])
  @@map("event_views")
}

// Prisma schema for Axon Tickets Online Ticketing Platform
// Run: npx prisma migrate dev --name init

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x", "linux-arm64-openssl-3.0.x", "linux-arm64-openssl-1.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum EventStatus {
  draft
  on_sale
  sold_out
  cancelled
  completed
}

enum OrderStatus {
  pending
  paid
  cancelled
  refunded
  failed
}

enum TicketStatus {
  valid
  used
  cancelled
  refunded
}

enum ReservationStatus {
  active
  expired
  converted
  released
}

enum OtpType {
  email_verify
  login
  phone_verify
}

enum OrgApprovalStatus {
  pending
  approved
  rejected
  suspended
  revoked
}

enum OrgMemberRole {
  owner
  admin // Legacy value retained for backwards-compatible reads; exposed as manager.
  co_owner
  manager
  member
}

enum OrgInvitationStatus {
  pending
  accepted
  revoked
  expired
}

enum RegistrationStatus {
  pending_payment
  proof_submitted
  pending_approval
  verified
  rejected
  cancelled
}

enum ProofStatus {
  pending
  approved
  rejected
}

enum ReferralDiscountType {
  percentage
  fixed_amount
}

enum EventInclusionStatus {
  draft
  active
  archived
}

enum InclusionFulfillmentMethod {
  pickup
  delivery
  digital
  manual
}

enum CheckoutQuoteStatus {
  active
  consumed
  expired
  cancelled
}

enum RegistrationLineItemKind {
  admission
  inclusion
  fee
  discount
}

enum InclusionReservationStatus {
  reserved
  confirmed
  released
  expired
}

enum InclusionInventoryMovementType {
  reserve
  confirm
  release
  expire
  adjust
  fulfill
  reverse
  refund
}

enum InclusionFulfillmentStatus {
  pending
  fulfilled
  reversed
  cancelled
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  phone        String?
  firstName    String?   @map("first_name")
  lastName     String?   @map("last_name")
  passwordHash String?   @map("password_hash")
  googleId     String?   @unique @map("google_id")
  avatarUrl    String?   @map("avatar_url")
  isVerified   Boolean   @default(false) @map("is_verified")
  isAdmin      Boolean   @default(false) @map("is_admin")
  isTest       Boolean   @default(false) @map("is_test")
  fraudScore   Int       @default(0) @map("fraud_score")
  // Conference registration fields (added for Francis Kong MVP)
  company      String?   @map("company")
  jobTitle     String?   @map("job_title")
  city         String?   @map("city")
  birthday     DateTime? @db.Date
  gender       String?
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  reservations                Reservation[]
  orders                      Order[]
  tickets                     Ticket[]
  otpCodes                    OtpCode[]
  fraudFlags                  FraudFlag[]
  events                      Event[]                      @relation("CreatedBy")
  checkIns                    Ticket[]                     @relation("CheckedInBy")
  attendanceCheckIns          AttendeeAttendance[]         @relation("AttendanceCheckedInBy")
  confirmedOrders             Order[]                      @relation("ConfirmedByAdmin")
  registrations               Registration[]
  verifiedRegistrations       Registration[]               @relation("VerifiedBy")
  reviewedProofs              PaymentProof[]               @relation("ReviewedBy")
  auditLogs                   AuditLog[]                   @relation("AuditPerformedBy")
  funnelEvents                RegistrationFunnelEvent[]
  organizationsCreated        Organization[]               @relation("OrgCreatedBy")
  organizationsApproved       Organization[]               @relation("OrgApprovedBy")
  organizationMembers         OrganizationMember[]
  organizationInvitationsSent OrganizationInvitation[]     @relation("OrganizationInvitationInvitedBy")
  workspaceMembers            WorkspaceMember[]
  workspacesClosed            EventWorkspace[]             @relation("WorkspaceClosedBy")
  workspaceItemsResponsible   WorkspaceItem[]              @relation("WorkspaceItemResponsible")
  workspaceItemsAccountable   WorkspaceItem[]              @relation("WorkspaceItemAccountable")
  workspaceReminderDeliveries WorkspaceReminderDelivery[]
  workspaceTaskUpdates        WorkspaceTaskUpdate[]
  inclusionQuotes             CheckoutQuote[]
  inclusionFulfillments       InclusionFulfillment[]       @relation("InclusionFulfilledBy")
  inclusionReversals          InclusionFulfillment[]       @relation("InclusionReversedBy")
  inclusionInventoryMovements InclusionInventoryMovement[] @relation("InclusionInventoryMovementActor")

  @@index([isTest, createdAt])
  @@map("users")
}

model Event {
  id                        String      @id @default(uuid())
  slug                      String      @unique
  title                     String
  description               String?
  venue                     String
  address                   String?     @map("address")
  landmark                  String?     @map("landmark")
  city                      String      @default("Manila")
  latitude                  Decimal?    @db.Decimal(10, 7)
  longitude                 Decimal?    @db.Decimal(10, 7)
  startsAt                  DateTime    @map("starts_at")
  endsAt                    DateTime?   @map("ends_at")
  imageUrl                  String?     @map("image_url")
  status                    EventStatus @default(draft)
  category                  String      @default("business")
  eventType                 String      @default("standard") @map("event_type")
  isTest                    Boolean     @default(false) @map("is_test")
  isOnline                  Boolean     @default(false) @map("is_online")
  publishedAt               DateTime?   @map("published_at")
  runningConfig             Json?       @map("running_config")
  maxCapacity               Int?        @map("max_capacity")
  maxPerUser                Int         @default(4) @map("max_per_user")
  // Conference-specific fields (added for Francis Kong MVP)
  speakerName               String?     @map("speaker_name")
  agenda                    Json? // Array of { time: string, title: string, description?: string }
  sponsors                  Json? // Array of { name: string, logoUrl?: string, tier?: string }
  faqs                      Json? // Array of { question: string, answer: string }
  customSections            Json?       @map("custom_sections") // Array of configurable event detail blocks
  // Featured hero fields
  tagline                   String?     @map("tagline") // Badge text e.g. "FULL-DAY LEADERSHIP CONFERENCE"
  featuredImageUrl          String?     @map("featured_image_url") // Dedicated 3:2 homepage hero artwork
  isFeatured                Boolean     @default(false) @map("is_featured")
  featuredOrder             Int?        @map("featured_order") // 1 = first slot; null = not featured
  featuredUntil             DateTime?   @map("featured_until") // auto-expiry; null = no expiry
  isFree                    Boolean     @default(false) @map("is_free")
  platformFee               Decimal     @default(50) @map("platform_fee") @db.Decimal(10, 2)
  // Payment configuration
  paymentMethods            Json?       @map("payment_methods") // Array of PaymentMethod objects
  allowManualPayment        Boolean     @default(true) @map("allow_manual_payment")
  onsiteRegistrationEnabled Boolean     @default(false) @map("onsite_registration_enabled")
  optionalInclusionsEnabled Boolean     @default(false) @map("optional_inclusions_enabled")
  bankName                  String?     @map("bank_name")
  bankAccountNumber         String?     @map("bank_account_number")
  bankAccountName           String?     @map("bank_account_name")
  gcashNumber               String?     @map("gcash_number")
  createdById               String      @map("created_by_id")
  organizationId            String?     @map("organization_id")
  createdAt                 DateTime    @default(now()) @map("created_at")
  updatedAt                 DateTime    @updatedAt @map("updated_at")

  createdBy          User                      @relation("CreatedBy", fields: [createdById], references: [id])
  organization       Organization?             @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  tiers              TicketTier[]
  reservations       Reservation[]
  orders             Order[]
  tickets            Ticket[]
  registrations      Registration[]
  attendanceRecords  AttendeeAttendance[]
  eventViews         EventView[]
  funnelEvents       RegistrationFunnelEvent[]
  workspace          EventWorkspace?
  referralCodes      ReferralCode[]
  attendees          Attendee[]
  bibCounters        RaceBibCounter[]
  optionalInclusions EventInclusion[]
  inclusionQuotes    CheckoutQuote[]

  @@index([status, startsAt])
  @@index([category, status, startsAt])
  @@index([eventType, status])
  @@index([publishedAt])
  @@index([slug])
  @@index([organizationId])
  @@index([isTest, status, startsAt])
  @@map("events")
}

model TicketTier {
  id            String    @id @default(uuid())
  eventId       String    @map("event_id")
  name          String
  description   String?
  price         Decimal   @db.Decimal(10, 2)
  currency      String    @default("PHP")
  totalQuantity Int       @map("total_quantity")
  soldQuantity  Int       @default(0) @map("sold_quantity")
  maxPerOrder   Int       @default(4) @map("max_per_order")
  saleStartsAt  DateTime? @map("sale_starts_at")
  saleEndsAt    DateTime? @map("sale_ends_at")
  isVisible     Boolean   @default(true) @map("is_visible")
  sortOrder     Int       @default(0) @map("sort_order")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  event                Event                      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  inclusions           TicketTierInclusion[]
  reservations         Reservation[]
  orderItems           OrderItem[]
  tickets              Ticket[]
  registrations        Registration[]
  inclusionEligibility InclusionTierEligibility[]
  inclusionQuotes      CheckoutQuote[]

  @@index([eventId])
  @@map("ticket_tiers")
}

model TicketTierInclusion {
  id          String   @id @default(uuid())
  tierId      String   @map("tier_id")
  label       String
  stubEnabled Boolean  @default(true) @map("stub_enabled")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tier TicketTier @relation(fields: [tierId], references: [id], onDelete: Cascade)

  @@unique([tierId, label])
  @@index([tierId, sortOrder])
  @@map("ticket_tier_inclusions")
}

model EventInclusion {
  id                      String                     @id @default(uuid())
  eventId                 String                     @map("event_id")
  name                    String
  description             String?
  status                  EventInclusionStatus       @default(draft)
  saleStartsAt            DateTime?                  @map("sale_starts_at")
  saleEndsAt              DateTime?                  @map("sale_ends_at")
  fulfillmentMethod       InclusionFulfillmentMethod @default(pickup) @map("fulfillment_method")
  fulfillmentInstructions String?                    @map("fulfillment_instructions")
  sortOrder               Int                        @default(0) @map("sort_order")
  createdAt               DateTime                   @default(now()) @map("created_at")
  updatedAt               DateTime                   @updatedAt @map("updated_at")
  archivedAt              DateTime?                  @map("archived_at")

  event         Event                      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  variants      InclusionVariant[]
  eligibleTiers InclusionTierEligibility[]

  @@index([eventId, status, sortOrder])
  @@map("event_inclusions")
}

model InclusionVariant {
  id            String   @id @default(uuid())
  inclusionId   String   @map("inclusion_id")
  name          String
  sku           String?
  price         Decimal  @db.Decimal(10, 2)
  currency      String   @default("PHP")
  totalStock    Int      @map("total_stock")
  reservedStock Int      @default(0) @map("reserved_stock")
  soldStock     Int      @default(0) @map("sold_stock")
  sortOrder     Int      @default(0) @map("sort_order")
  isActive      Boolean  @default(true) @map("is_active")
  version       Int      @default(0)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  inclusion    EventInclusion                  @relation(fields: [inclusionId], references: [id], onDelete: Cascade)
  reservations InclusionInventoryReservation[]
  movements    InclusionInventoryMovement[]

  @@unique([inclusionId, name])
  @@unique([inclusionId, sku])
  @@index([inclusionId, isActive, sortOrder])
  @@map("inclusion_variants")
}

model InclusionTierEligibility {
  inclusionId                String @map("inclusion_id")
  ticketTierId               String @map("ticket_tier_id")
  maxQuantityPerRegistration Int?   @map("max_quantity_per_registration")

  inclusion  EventInclusion @relation(fields: [inclusionId], references: [id], onDelete: Cascade)
  ticketTier TicketTier     @relation(fields: [ticketTierId], references: [id], onDelete: Cascade)

  @@id([inclusionId, ticketTierId])
  @@index([ticketTierId])
  @@map("inclusion_tier_eligibility")
}

model CheckoutQuote {
  id                String              @id @default(uuid())
  token             String              @unique @default(uuid())
  eventId           String              @map("event_id")
  ticketTierId      String              @map("ticket_tier_id")
  userId            String?             @map("user_id")
  registrationId    String?             @unique @map("registration_id")
  status            CheckoutQuoteStatus @default(active)
  attendeeCount     Int                 @map("attendee_count")
  admissionSubtotal Decimal             @map("admission_subtotal") @db.Decimal(10, 2)
  inclusionSubtotal Decimal             @map("inclusion_subtotal") @db.Decimal(10, 2)
  discount          Decimal             @default(0) @db.Decimal(10, 2)
  fees              Decimal             @default(0) @db.Decimal(10, 2)
  total             Decimal             @db.Decimal(10, 2)
  currency          String              @default("PHP")
  referralCode      String?             @map("referral_code")
  pricingSnapshot   Json                @map("pricing_snapshot")
  expiresAt         DateTime            @map("expires_at")
  consumedAt        DateTime?           @map("consumed_at")
  createdAt         DateTime            @default(now()) @map("created_at")

  event        Event                           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  ticketTier   TicketTier                      @relation(fields: [ticketTierId], references: [id], onDelete: Restrict)
  user         User?                           @relation(fields: [userId], references: [id], onDelete: SetNull)
  registration Registration?                   @relation(fields: [registrationId], references: [id], onDelete: SetNull)
  reservations InclusionInventoryReservation[]

  @@index([eventId, status, expiresAt])
  @@index([userId, status])
  @@map("checkout_quotes")
}

model RegistrationLineItem {
  id                              String                      @id @default(uuid())
  registrationId                  String                      @map("registration_id")
  kind                            RegistrationLineItemKind
  sourceId                        String?                     @map("source_id")
  nameSnapshot                    String                      @map("name_snapshot")
  variantSnapshot                 String?                     @map("variant_snapshot")
  assignedAttendeeId              String?                     @map("assigned_attendee_id")
  quantity                        Int
  unitPrice                       Decimal                     @map("unit_price") @db.Decimal(10, 2)
  total                           Decimal                     @db.Decimal(10, 2)
  fulfillmentMethodSnapshot       InclusionFulfillmentMethod? @map("fulfillment_method_snapshot")
  fulfillmentInstructionsSnapshot String?                     @map("fulfillment_instructions_snapshot")
  createdAt                       DateTime                    @default(now()) @map("created_at")

  registration Registration                    @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  attendee     Attendee?                       @relation(fields: [assignedAttendeeId], references: [id], onDelete: SetNull)
  reservations InclusionInventoryReservation[]
  fulfillments InclusionFulfillment[]

  @@index([registrationId, kind])
  @@index([assignedAttendeeId])
  @@map("registration_line_items")
}

model InclusionInventoryReservation {
  id                  String                     @id @default(uuid())
  registrationId      String                     @map("registration_id")
  quoteId             String?                    @map("quote_id")
  lineItemId          String                     @map("line_item_id")
  variantId           String                     @map("variant_id")
  quantity            Int
  status              InclusionReservationStatus @default(reserved)
  expiresAt           DateTime                   @map("expires_at")
  confirmedAt         DateTime?                  @map("confirmed_at")
  releasedAt          DateTime?                  @map("released_at")
  rejectionGraceUntil DateTime?                  @map("rejection_grace_until")
  idempotencyKey      String                     @unique @map("idempotency_key")
  createdAt           DateTime                   @default(now()) @map("created_at")
  updatedAt           DateTime                   @updatedAt @map("updated_at")

  registration Registration                 @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  quote        CheckoutQuote?               @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  lineItem     RegistrationLineItem         @relation(fields: [lineItemId], references: [id], onDelete: Cascade)
  variant      InclusionVariant             @relation(fields: [variantId], references: [id], onDelete: Restrict)
  movements    InclusionInventoryMovement[]

  @@index([registrationId, status])
  @@index([variantId, status])
  @@index([status, expiresAt])
  @@index([status, rejectionGraceUntil])
  @@map("inclusion_inventory_reservations")
}

model InclusionInventoryMovement {
  id            String                         @id @default(uuid())
  variantId     String                         @map("variant_id")
  reservationId String?                        @map("reservation_id")
  type          InclusionInventoryMovementType
  quantity      Int
  reason        String?
  actorId       String?                        @map("actor_id")
  metadata      Json?
  createdAt     DateTime                       @default(now()) @map("created_at")

  variant     InclusionVariant               @relation(fields: [variantId], references: [id], onDelete: Restrict)
  reservation InclusionInventoryReservation? @relation(fields: [reservationId], references: [id], onDelete: SetNull)
  actor       User?                          @relation("InclusionInventoryMovementActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([variantId, createdAt])
  @@index([reservationId])
  @@map("inclusion_inventory_movements")
}

model InclusionFulfillment {
  id             String                     @id @default(uuid())
  lineItemId     String                     @unique @map("line_item_id")
  status         InclusionFulfillmentStatus @default(pending)
  quantity       Int
  fulfilledById  String?                    @map("fulfilled_by_id")
  fulfilledAt    DateTime?                  @map("fulfilled_at")
  reversedById   String?                    @map("reversed_by_id")
  reversedAt     DateTime?                  @map("reversed_at")
  reversalReason String?                    @map("reversal_reason")
  createdAt      DateTime                   @default(now()) @map("created_at")
  updatedAt      DateTime                   @updatedAt @map("updated_at")

  lineItem    RegistrationLineItem @relation(fields: [lineItemId], references: [id], onDelete: Cascade)
  fulfilledBy User?                @relation("InclusionFulfilledBy", fields: [fulfilledById], references: [id], onDelete: SetNull)
  reversedBy  User?                @relation("InclusionReversedBy", fields: [reversedById], references: [id], onDelete: SetNull)

  @@index([lineItemId, status])
  @@index([status, createdAt])
  @@map("inclusion_fulfillments")
}

model Reservation {
  id             String            @id @default(uuid())
  userId         String            @map("user_id")
  ticketTierId   String            @map("ticket_tier_id")
  eventId        String            @map("event_id")
  quantity       Int
  expiresAt      DateTime          @map("expires_at")
  status         ReservationStatus @default(active)
  idempotencyKey String            @unique @map("idempotency_key")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  user       User       @relation(fields: [userId], references: [id])
  ticketTier TicketTier @relation(fields: [ticketTierId], references: [id])
  event      Event      @relation(fields: [eventId], references: [id])
  order      Order?

  @@index([userId, status])
  @@index([status, expiresAt])
  @@map("reservations")
}

model Order {
  id                 String      @id @default(uuid())
  userId             String      @map("user_id")
  reservationId      String      @unique @map("reservation_id")
  eventId            String      @map("event_id")
  status             OrderStatus @default(pending)
  subtotal           Decimal     @db.Decimal(10, 2)
  fees               Decimal     @db.Decimal(10, 2)
  total              Decimal     @db.Decimal(10, 2)
  currency           String      @default("PHP")
  paymentMethod      String?     @map("payment_method")
  paymentRef         String?     @map("payment_ref")
  paymentLinkId      String?     @map("payment_link_id")
  idempotencyKey     String      @unique @map("idempotency_key")
  ipAddress          String?     @map("ip_address")
  userAgent          String?     @map("user_agent")
  // Manual payment confirmation audit trail
  confirmedByAdminId String?     @map("confirmed_by_admin_id")
  confirmedAt        DateTime?   @map("confirmed_at")
  createdAt          DateTime    @default(now()) @map("created_at")
  updatedAt          DateTime    @updatedAt @map("updated_at")

  user             User        @relation(fields: [userId], references: [id])
  reservation      Reservation @relation(fields: [reservationId], references: [id])
  event            Event       @relation(fields: [eventId], references: [id])
  items            OrderItem[]
  tickets          Ticket[]
  fraudFlags       FraudFlag[]
  confirmedByAdmin User?       @relation("ConfirmedByAdmin", fields: [confirmedByAdminId], references: [id])

  @@index([userId, status])
  @@index([eventId])
  @@index([status])
  @@index([status, createdAt])
  @@map("orders")
}

model OrderItem {
  id           String   @id @default(uuid())
  orderId      String   @map("order_id")
  ticketTierId String   @map("ticket_tier_id")
  quantity     Int
  unitPrice    Decimal  @map("unit_price") @db.Decimal(10, 2)
  subtotal     Decimal  @db.Decimal(10, 2)
  createdAt    DateTime @default(now()) @map("created_at")

  order      Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  ticketTier TicketTier @relation(fields: [ticketTierId], references: [id])
  tickets    Ticket[]

  @@index([orderId])
  @@map("order_items")
}

model Ticket {
  id            String       @id @default(uuid())
  orderId       String       @map("order_id")
  orderItemId   String       @map("order_item_id")
  userId        String       @map("user_id")
  eventId       String       @map("event_id")
  ticketTierId  String       @map("ticket_tier_id")
  qrCode        String       @unique @map("qr_code")
  status        TicketStatus @default(valid)
  checkedInAt   DateTime?    @map("checked_in_at")
  checkedInById String?      @map("checked_in_by_id")
  createdAt     DateTime     @default(now()) @map("created_at")

  order       Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderItem   OrderItem  @relation(fields: [orderItemId], references: [id])
  user        User       @relation(fields: [userId], references: [id])
  event       Event      @relation(fields: [eventId], references: [id])
  ticketTier  TicketTier @relation(fields: [ticketTierId], references: [id])
  checkedInBy User?      @relation("CheckedInBy", fields: [checkedInById], references: [id])

  @@index([userId])
  @@index([eventId, status])
  @@index([ticketTierId, status])
  @@index([orderId])
  @@map("tickets")
}

model OtpCode {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  codeHash  String   @map("code_hash")
  type      OtpType
  expiresAt DateTime @map("expires_at")
  used      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type, used])
  @@index([expiresAt])
  @@map("otp_codes")
}

model FraudFlag {
  id         String    @id @default(uuid())
  userId     String?   @map("user_id")
  orderId    String?   @map("order_id")
  reason     String
  ipAddress  String?   @map("ip_address")
  metadata   Json?
  resolvedAt DateTime? @map("resolved_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user  User?  @relation(fields: [userId], references: [id])
  order Order? @relation(fields: [orderId], references: [id])

  @@index([userId])
  @@index([orderId])
  @@map("fraud_flags")
}

// ── Manual-payment registration flow ─────────────────────────────────────────

model Registration {
  id                   String             @id @default(uuid())
  referenceNumber      String             @unique @map("reference_number")
  userId               String?            @map("user_id")
  guestEmail           String?            @map("guest_email")
  guestAccessTokenHash String?            @map("guest_access_token_hash")
  accountConsent       Boolean            @default(false) @map("account_consent")
  accountConsentAt     DateTime?          @map("account_consent_at")
  attendeesCompletedAt DateTime?          @map("attendees_completed_at")
  eventId              String             @map("event_id")
  tierId               String?            @map("tier_id")
  tierName             String?            @map("tier_name")
  unitPrice            Decimal?           @map("unit_price") @db.Decimal(10, 2)
  status               RegistrationStatus @default(pending_payment)
  attendeeCount        Int                @map("attendee_count")
  subtotal             Decimal            @db.Decimal(10, 2)
  fees                 Decimal            @db.Decimal(10, 2)
  total                Decimal            @db.Decimal(10, 2)
  discount             Decimal            @default(0) @db.Decimal(10, 2)
  referralCodeId       String?            @map("referral_code_id")
  referralCodeSnapshot Json?              @map("referral_code_snapshot")
  currency             String             @default("PHP")
  paymentMethod        String?            @map("payment_method")
  notes                String?
  rejectionReason      String?            @map("rejection_reason")
  verifiedById         String?            @map("verified_by_id")
  verifiedAt           DateTime?          @map("verified_at")
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")

  user                  User?                           @relation(fields: [userId], references: [id])
  event                 Event                           @relation(fields: [eventId], references: [id])
  tier                  TicketTier?                     @relation(fields: [tierId], references: [id])
  attendees             Attendee[]
  attendanceRecords     AttendeeAttendance[]
  proofs                PaymentProof[]
  verifiedBy            User?                           @relation("VerifiedBy", fields: [verifiedById], references: [id])
  auditLogs             AuditLog[]
  referralCode          ReferralCode?                   @relation(fields: [referralCodeId], references: [id], onDelete: SetNull)
  referralUsage         ReferralCodeUsage?
  inclusionQuote        CheckoutQuote?
  lineItems             RegistrationLineItem[]
  inclusionReservations InclusionInventoryReservation[]

  @@index([userId, status])
  @@index([guestEmail, status])
  @@index([eventId, status])
  @@index([tierId, status])
  @@index([status, createdAt])
  @@index([status, verifiedAt])
  @@index([referenceNumber])
  @@map("registrations")
}

model Attendee {
  id                           String    @id @default(uuid())
  registrationId               String    @map("registration_id")
  eventId                      String    @map("event_id")
  firstName                    String    @map("first_name")
  lastName                     String    @map("last_name")
  email                        String?
  phone                        String?
  company                      String?
  jobTitle                     String?   @map("job_title")
  birthday                     DateTime? @db.Date
  ageAtEvent                   Int?      @map("age_at_event")
  ageGroupName                 String?   @map("age_group_name")
  gender                       String?
  raceDistance                 String?   @map("race_distance")
  raceDivision                 String?   @map("race_division")
  genderIdentity               String?   @map("gender_identity")
  emergencyContactName         String?   @map("emergency_contact_name")
  emergencyContactPhone        String?   @map("emergency_contact_phone")
  emergencyContactRelationship String?   @map("emergency_contact_relationship")
  merchandiseSize              String?   @map("merchandise_size")
  claimMethod                  String?   @map("claim_method")
  deliveryAddress              Json?     @map("delivery_address")
  bibNumber                    String?   @map("bib_number")
  bibSequence                  Int?      @map("bib_sequence")
  bibAssignedAt                DateTime? @map("bib_assigned_at")
  claimedAt                    DateTime? @map("claimed_at")
  city                         String?
  subEventId                   String?   @map("sub_event_id")
  subEventTitle                String?   @map("sub_event_title")
  subEventTime                 String?   @map("sub_event_time")
  selectedSubEvents            Json?     @map("selected_sub_events")
  isLead                       Boolean   @default(false) @map("is_lead")
  // Anti-scalper: tickets are bound to the attendee record above and cannot
  // be re-assigned. Reserved for a future admin-controlled transfer flow.
  transferable                 Boolean   @default(false) @map("transferable")
  qrToken                      String?   @unique @map("qr_token")
  checkedInAt                  DateTime? @map("checked_in_at")
  checkedInById                String?   @map("checked_in_by_id")
  checkInMethod                String?   @map("check_in_method")
  createdAt                    DateTime  @default(now()) @map("created_at")

  registration       Registration           @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  event              Event                  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  attendanceRecords  AttendeeAttendance[]
  inclusionLineItems RegistrationLineItem[]

  @@unique([eventId, raceDistance, bibSequence])
  @@index([registrationId])
  @@index([eventId, raceDistance])
  @@index([eventId, ageGroupName])
  @@index([createdAt])
  @@index([email])
  @@index([eventId, email])
  @@index([subEventId])
  @@map("attendees")
}

model GuestRegistrationEmailClaim {
  id             String   @id @default(uuid())
  eventId        String   @map("event_id")
  registrationId String   @map("registration_id")
  emailHash      String   @map("email_hash")
  createdAt      DateTime @default(now()) @map("created_at")

  @@unique([eventId, emailHash])
  @@index([registrationId])
  @@map("guest_registration_email_claims")
}

model RaceBibCounter {
  id        String   @id @default(uuid())
  eventId   String   @map("event_id")
  distance  String
  nextValue Int      @default(1) @map("next_value")
  updatedAt DateTime @updatedAt @map("updated_at")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, distance])
  @@index([eventId])
  @@map("race_bib_counters")
}

model AttendeeAttendance {
  id             String   @id @default(uuid())
  attendeeId     String   @map("attendee_id")
  registrationId String   @map("registration_id")
  eventId        String   @map("event_id")
  checkInDate    DateTime @map("check_in_date") @db.Date
  checkedInAt    DateTime @default(now()) @map("checked_in_at")
  checkedInById  String?  @map("checked_in_by_id")
  checkInMethod  String   @map("check_in_method")
  createdAt      DateTime @default(now()) @map("created_at")

  attendee     Attendee     @relation(fields: [attendeeId], references: [id], onDelete: Cascade)
  registration Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  event        Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  checkedInBy  User?        @relation("AttendanceCheckedInBy", fields: [checkedInById], references: [id])

  @@unique([attendeeId, eventId, checkInDate])
  @@index([eventId, checkInDate])
  @@index([registrationId])
  @@index([checkedInById])
  @@map("attendee_attendance")
}

model ReferralCode {
  id                String               @id @default(uuid())
  eventId           String               @map("event_id")
  code              String
  name              String
  discountType      ReferralDiscountType @map("discount_type")
  discountValue     Decimal              @map("discount_value") @db.Decimal(10, 2)
  isActive          Boolean              @default(true) @map("is_active")
  maxUses           Int?                 @map("max_uses")
  validFrom         DateTime?            @map("valid_from")
  validUntil        DateTime?            @map("valid_until")
  applicableTierIds Json?                @map("applicable_tier_ids")
  createdById       String               @map("created_by_id")
  createdAt         DateTime             @default(now()) @map("created_at")
  deactivatedAt     DateTime?            @map("deactivated_at")
  deletedAt         DateTime?            @map("deleted_at")

  event         Event               @relation(fields: [eventId], references: [id], onDelete: Cascade)
  registrations Registration[]
  usages        ReferralCodeUsage[]

  @@unique([eventId, code])
  @@index([eventId, isActive])
  @@map("referral_codes")
}

model ReferralCodeUsage {
  id             String   @id @default(uuid())
  referralCodeId String   @map("referral_code_id")
  registrationId String   @unique @map("registration_id")
  discountAmount Decimal  @map("discount_amount") @db.Decimal(10, 2)
  attendeeCount  Int      @map("attendee_count")
  createdAt      DateTime @default(now()) @map("created_at")

  referralCode ReferralCode @relation(fields: [referralCodeId], references: [id], onDelete: Restrict)
  registration Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  @@index([referralCodeId, createdAt])
  @@map("referral_code_usages")
}

model PaymentProof {
  id                 String      @id @default(uuid())
  registrationId     String      @map("registration_id")
  imageUrl           String      @map("image_url")
  cloudinaryPublicId String      @map("cloudinary_public_id")
  status             ProofStatus @default(pending)
  reviewedById       String?     @map("reviewed_by_id")
  reviewedAt         DateTime?   @map("reviewed_at")
  rejectionReason    String?     @map("rejection_reason")
  createdAt          DateTime    @default(now()) @map("created_at")

  registration Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  reviewedBy   User?        @relation("ReviewedBy", fields: [reviewedById], references: [id])

  @@index([registrationId])
  @@index([status])
  @@index([createdAt])
  @@map("payment_proofs")
}

model AuditLog {
  id             String   @id @default(uuid())
  action         String
  entityType     String   @map("entity_type")
  entityId       String   @map("entity_id")
  registrationId String?  @map("registration_id")
  performedById  String?  @map("performed_by_id")
  metadata       Json?
  ipAddress      String?  @map("ip_address")
  createdAt      DateTime @default(now()) @map("created_at")

  registration Registration? @relation(fields: [registrationId], references: [id])
  performedBy  User?         @relation("AuditPerformedBy", fields: [performedById], references: [id])

  @@index([entityType, entityId])
  @@index([registrationId])
  @@index([performedById])
  @@index([createdAt])
  @@map("audit_logs")
}

model EventView {
  id        String   @id @default(uuid())
  eventId   String   @map("event_id")
  sessionId String?  @map("session_id")
  referrer  String?
  createdAt DateTime @default(now()) @map("created_at")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([createdAt])
  @@map("event_views")
}

model RegistrationFunnelEvent {
  id        String   @id @default(uuid())
  eventId   String?  @map("event_id")
  sessionId String?  @map("session_id")
  userId    String?  @map("user_id")
  email     String?
  step      String
  status    String
  metadata  Json?
  userAgent String?  @map("user_agent")
  referrer  String?
  createdAt DateTime @default(now()) @map("created_at")

  event Event? @relation(fields: [eventId], references: [id], onDelete: SetNull)
  user  User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([eventId, step])
  @@index([step, status])
  @@index([userId])
  @@index([createdAt])
  @@map("registration_funnel_events")
}

// ── Organizer Management ──────────────────────────────────────────────────────

model Organization {
  id                 String            @id @default(uuid())
  name               String
  description        String
  contactName        String            @map("contact_name")
  phone              String
  city               String
  idType             String            @map("id_type")
  idNumber           String            @map("id_number")
  organizationType   String            @map("organization_type")
  registrationNumber String?           @map("registration_number")
  website            String?
  facebookUrl        String?           @map("facebook_url")
  publicSlug         String?           @unique @map("public_slug")
  logoUrl            String?           @map("logo_url")
  socialLinks        Json?             @map("social_links")
  isPublic           Boolean           @default(true) @map("is_public")
  isTest             Boolean           @default(false) @map("is_test")
  hiddenAt           DateTime?         @map("hidden_at")
  profileUpdatedAt   DateTime?         @map("profile_updated_at")
  approvalStatus     OrgApprovalStatus @default(pending) @map("approval_status")
  approvedById       String?           @map("approved_by_id")
  approvedAt         DateTime?         @map("approved_at")
  rejectedAt         DateTime?         @map("rejected_at")
  rejectionReason    String?           @map("rejection_reason")
  createdById        String            @map("created_by_id")
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")

  createdBy   User                     @relation("OrgCreatedBy", fields: [createdById], references: [id])
  approvedBy  User?                    @relation("OrgApprovedBy", fields: [approvedById], references: [id])
  members     OrganizationMember[]
  invitations OrganizationInvitation[]
  events      Event[]

  @@index([approvalStatus])
  @@index([isPublic, approvalStatus])
  @@index([createdById])
  @@index([isTest, approvalStatus])
  @@map("organizations")
}

model OrganizationMember {
  id             String        @id @default(uuid())
  userId         String        @map("user_id")
  organizationId String        @map("organization_id")
  role           OrgMemberRole @default(member)
  createdAt      DateTime      @default(now()) @map("created_at")

  user         User         @relation(fields: [userId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([userId])
  @@index([organizationId])
  @@map("organization_members")
}

model OrganizationInvitation {
  id             String              @id @default(uuid())
  organizationId String              @map("organization_id")
  email          String
  role           OrgMemberRole
  status         OrgInvitationStatus @default(pending)
  invitedById    String              @map("invited_by_id")
  expiresAt      DateTime            @map("expires_at")
  acceptedAt     DateTime?           @map("accepted_at")
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy    User         @relation("OrganizationInvitationInvitedBy", fields: [invitedById], references: [id], onDelete: Cascade)

  @@unique([organizationId, email])
  @@index([email, status])
  @@index([organizationId, status])
  @@map("organization_invitations")
}

// ── Event Workspace ───────────────────────────────────────────────────────────

enum WorkspaceRole {
  manager
  editor
  viewer
}

enum ChecklistStatus {
  open
  in_progress
  done
  blocked
  not_applicable
}

enum ChecklistPriority {
  low
  medium
  high
  critical
}

enum MilestoneStatus {
  upcoming
  at_risk
  done
  overdue
}

model EventWorkspace {
  id                String    @id @default(uuid())
  eventId           String    @unique @map("event_id")
  closedAt          DateTime? @map("closed_at")
  closedById        String?   @map("closed_by_id")
  readinessSnapshot Json?     @map("readiness_snapshot")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  event      Event                @relation(fields: [eventId], references: [id], onDelete: Cascade)
  closedBy   User?                @relation("WorkspaceClosedBy", fields: [closedById], references: [id])
  members    WorkspaceMember[]
  items      WorkspaceItem[]
  categories WorkspaceCategory[]
  milestones WorkspaceMilestone[]

  @@map("event_workspaces")
}

model WorkspaceMember {
  id          String        @id @default(uuid())
  workspaceId String        @map("workspace_id")
  userId      String        @map("user_id")
  role        WorkspaceRole @default(viewer)
  createdAt   DateTime      @default(now()) @map("created_at")

  workspace EventWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User           @relation(fields: [userId], references: [id])

  @@unique([workspaceId, userId])
  @@index([workspaceId])
  @@index([userId])
  @@map("workspace_members")
}

model WorkspaceItem {
  id                  String            @id @default(uuid())
  workspaceId         String            @map("workspace_id")
  title               String
  description         String?
  category            String            @default("general")
  status              ChecklistStatus   @default(open)
  priority            ChecklistPriority @default(medium)
  isBlocker           Boolean           @default(false) @map("is_blocker")
  startDate           DateTime?         @map("start_date")
  dueDate             DateTime?         @map("due_date")
  assignedToName      String?           @map("assigned_to_name")
  accountableName     String?           @map("accountable_name")
  categoryId          String?           @map("category_id")
  assignedToUserId    String?           @map("assigned_to_user_id")
  accountableToUserId String?           @map("accountable_to_user_id")
  notes               String?
  completedAt         DateTime?         @map("completed_at")
  sortOrder           Int               @default(0) @map("sort_order")
  createdAt           DateTime          @default(now()) @map("created_at")
  updatedAt           DateTime          @updatedAt @map("updated_at")

  workspace          EventWorkspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  categoryRecord     WorkspaceCategory?          @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  assignedToUser     User?                       @relation("WorkspaceItemResponsible", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  accountableToUser  User?                       @relation("WorkspaceItemAccountable", fields: [accountableToUserId], references: [id], onDelete: SetNull)
  reminderDeliveries WorkspaceReminderDelivery[]
  updates            WorkspaceTaskUpdate[]

  @@index([workspaceId])
  @@index([categoryId])
  @@index([assignedToUserId])
  @@index([accountableToUserId])
  @@map("workspace_items")
}

model WorkspaceTaskUpdate {
  id              String           @id @default(uuid())
  workspaceItemId String           @map("workspace_item_id")
  authorUserId    String           @map("author_user_id")
  message         String?
  previousStatus  ChecklistStatus? @map("previous_status")
  nextStatus      ChecklistStatus? @map("next_status")
  createdAt       DateTime         @default(now()) @map("created_at")

  workspaceItem WorkspaceItem @relation(fields: [workspaceItemId], references: [id], onDelete: Cascade)
  author        User          @relation(fields: [authorUserId], references: [id], onDelete: Cascade)

  @@index([workspaceItemId, createdAt])
  @@index([authorUserId, createdAt])
  @@map("workspace_task_updates")
}

model WorkspaceCategory {
  id          String   @id @default(uuid())
  workspaceId String   @map("workspace_id")
  name        String
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  workspace EventWorkspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  items     WorkspaceItem[]

  @@unique([workspaceId, name])
  @@index([workspaceId, sortOrder])
  @@map("workspace_categories")
}

model WorkspaceReminderDelivery {
  id              String   @id @default(uuid())
  workspaceItemId String   @map("workspace_item_id")
  recipientUserId String   @map("recipient_user_id")
  reminderKey     String   @map("reminder_key")
  sentAt          DateTime @default(now()) @map("sent_at")

  workspaceItem WorkspaceItem @relation(fields: [workspaceItemId], references: [id], onDelete: Cascade)
  recipientUser User          @relation(fields: [recipientUserId], references: [id], onDelete: Cascade)

  @@unique([workspaceItemId, recipientUserId, reminderKey])
  @@index([recipientUserId, sentAt])
  @@map("workspace_reminder_deliveries")
}

model WorkspaceMilestone {
  id          String          @id @default(uuid())
  workspaceId String          @map("workspace_id")
  title       String
  dueDate     DateTime        @map("due_date")
  status      MilestoneStatus @default(upcoming)
  notes       String?
  completedAt DateTime?       @map("completed_at")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  workspace EventWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@map("workspace_milestones")
}

// ── Platform-wide configuration ───────────────────────────────────────────────
// Each row is a key/value pair. Admins manage these via /admin/settings/platform.
// Keys: "service_fee" (pesos, stored as string, e.g. "50")

model PlatformConfig {
  key         String   @id
  value       String
  updatedById String?  @map("updated_by_id")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("platform_configs")
}

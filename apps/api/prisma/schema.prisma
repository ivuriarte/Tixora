// Prisma schema for Axon Tickets Online Ticketing Platform
// Run: npx prisma migrate dev --name init

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum EventStatus {
  draft
  published
  on_sale
  sold_out
  cancelled
  completed
}

enum OrderStatus {
  pending
  paid
  cancelled
  refunded
  failed
}

enum TicketStatus {
  valid
  used
  cancelled
  refunded
}

enum ReservationStatus {
  active
  expired
  converted
  released
}

enum OtpType {
  email_verify
  login
  phone_verify
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  phone        String?
  firstName    String   @map("first_name")
  lastName     String   @map("last_name")
  passwordHash String?  @map("password_hash")
  isVerified   Boolean  @default(false) @map("is_verified")
  isAdmin      Boolean  @default(false) @map("is_admin")
  fraudScore   Int      @default(0) @map("fraud_score")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  reservations Reservation[]
  orders       Order[]
  tickets      Ticket[]
  otpCodes     OtpCode[]
  fraudFlags   FraudFlag[]
  events       Event[]         @relation("CreatedBy")
  checkIns     Ticket[]        @relation("CheckedInBy")

  @@map("users")
}

model Event {
  id          String      @id @default(uuid())
  slug        String      @unique
  title       String
  description String?
  venue       String
  city        String      @default("Manila")
  startsAt    DateTime    @map("starts_at")
  endsAt      DateTime?   @map("ends_at")
  imageUrl    String?     @map("image_url")
  status      EventStatus @default(draft)
  maxPerUser  Int         @default(4) @map("max_per_user")
  createdById String      @map("created_by_id")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  createdBy   User         @relation("CreatedBy", fields: [createdById], references: [id])
  tiers       TicketTier[]
  reservations Reservation[]
  orders      Order[]
  tickets     Ticket[]

  @@index([status, startsAt])
  @@index([slug])
  @@map("events")
}

model TicketTier {
  id           String    @id @default(uuid())
  eventId      String    @map("event_id")
  name         String
  description  String?
  price        Decimal   @db.Decimal(10, 2)
  currency     String    @default("PHP")
  totalQuantity Int      @map("total_quantity")
  soldQuantity  Int      @default(0) @map("sold_quantity")
  maxPerOrder  Int       @default(4) @map("max_per_order")
  saleStartsAt DateTime? @map("sale_starts_at")
  saleEndsAt   DateTime? @map("sale_ends_at")
  isVisible    Boolean   @default(true) @map("is_visible")
  sortOrder    Int       @default(0) @map("sort_order")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  event        Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  reservations Reservation[]
  orderItems   OrderItem[]
  tickets      Ticket[]

  @@index([eventId])
  @@map("ticket_tiers")
}

model Reservation {
  id              String            @id @default(uuid())
  userId          String            @map("user_id")
  ticketTierId    String            @map("ticket_tier_id")
  eventId         String            @map("event_id")
  quantity        Int
  expiresAt       DateTime          @map("expires_at")
  status          ReservationStatus @default(active)
  idempotencyKey  String            @unique @map("idempotency_key")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  user       User       @relation(fields: [userId], references: [id])
  ticketTier TicketTier @relation(fields: [ticketTierId], references: [id])
  event      Event      @relation(fields: [eventId], references: [id])
  order      Order?

  @@index([userId, status])
  @@index([status, expiresAt])
  @@map("reservations")
}

model Order {
  id              String      @id @default(uuid())
  userId          String      @map("user_id")
  reservationId   String      @unique @map("reservation_id")
  eventId         String      @map("event_id")
  status          OrderStatus @default(pending)
  subtotal        Decimal     @db.Decimal(10, 2)
  fees            Decimal     @db.Decimal(10, 2)
  total           Decimal     @db.Decimal(10, 2)
  currency        String      @default("PHP")
  paymentMethod   String?     @map("payment_method")
  paymentRef      String?     @map("payment_ref")
  paymentLinkId   String?     @map("payment_link_id")
  idempotencyKey  String      @unique @map("idempotency_key")
  ipAddress       String?     @map("ip_address")
  userAgent       String?     @map("user_agent")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  user        User        @relation(fields: [userId], references: [id])
  reservation Reservation @relation(fields: [reservationId], references: [id])
  event       Event       @relation(fields: [eventId], references: [id])
  items       OrderItem[]
  tickets     Ticket[]
  fraudFlags  FraudFlag[]

  @@index([userId, status])
  @@index([status])
  @@map("orders")
}

model OrderItem {
  id           String   @id @default(uuid())
  orderId      String   @map("order_id")
  ticketTierId String   @map("ticket_tier_id")
  quantity     Int
  unitPrice    Decimal  @map("unit_price") @db.Decimal(10, 2)
  subtotal     Decimal  @db.Decimal(10, 2)
  createdAt    DateTime @default(now()) @map("created_at")

  order      Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  ticketTier TicketTier @relation(fields: [ticketTierId], references: [id])
  tickets    Ticket[]

  @@index([orderId])
  @@map("order_items")
}

model Ticket {
  id           String       @id @default(uuid())
  orderId      String       @map("order_id")
  orderItemId  String       @map("order_item_id")
  userId       String       @map("user_id")
  eventId      String       @map("event_id")
  ticketTierId String       @map("ticket_tier_id")
  qrCode       String       @unique @map("qr_code")
  status       TicketStatus @default(valid)
  checkedInAt  DateTime?    @map("checked_in_at")
  checkedInById String?     @map("checked_in_by_id")
  createdAt    DateTime     @default(now()) @map("created_at")

  order       Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderItem   OrderItem  @relation(fields: [orderItemId], references: [id])
  user        User       @relation(fields: [userId], references: [id])
  event       Event      @relation(fields: [eventId], references: [id])
  ticketTier  TicketTier @relation(fields: [ticketTierId], references: [id])
  checkedInBy User?      @relation("CheckedInBy", fields: [checkedInById], references: [id])

  @@index([userId])
  @@index([eventId, status])
  @@index([orderId])
  @@map("tickets")
}

model OtpCode {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  codeHash  String   @map("code_hash")
  type      OtpType
  expiresAt DateTime @map("expires_at")
  used      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type, used])
  @@map("otp_codes")
}

model FraudFlag {
  id        String   @id @default(uuid())
  userId    String?  @map("user_id")
  orderId   String?  @map("order_id")
  reason    String
  ipAddress String?  @map("ip_address")
  metadata  Json?
  resolvedAt DateTime? @map("resolved_at")
  createdAt DateTime @default(now()) @map("created_at")

  user  User?  @relation(fields: [userId], references: [id])
  order Order? @relation(fields: [orderId], references: [id])

  @@index([userId])
  @@index([orderId])
  @@map("fraud_flags")
}

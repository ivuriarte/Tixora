{
  "buildCommand": "npm run vercel-build",
  "installCommand": "cd ../../ && npm install --include=dev",
  "outputDirectory": ".",
  "functions": {
    "api/index.js": {
      "memory": 1024,
      "maxDuration": 30,
      "includeFiles": "api/{libquery_engine*.node,schema.prisma,client/libquery_engine*.node}"
    }
  },
  "crons": [
    { "path": "/api/v1/cron/workspace-due-reminders", "schedule": "0 0 * * *" }
  ],
  "rewrites": [
    { "source": "/(.*)", "destination": "/api/index" }
  ]
}
